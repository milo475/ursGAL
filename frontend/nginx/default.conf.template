# ursGAL web (Railway): SPA + /api → API_UPSTREAM proxy
server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 12m;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Railway-ийн дотоод DNS (private networking) — upstream-ийг ажиллах
    # үед нь шийднэ, api дахин deploy болж IP солигдсон ч алдахгүй.
    resolver [fd12::10] valid=10s ipv6=on;
    set $api_upstream ${API_UPSTREAM};

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
        # SSE (/api/notifications/stream) — буфергүй, урт холболт
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # hash-тай asset-ууд — урт cache
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html, service worker хэзээ ч cache-лэгдэхгүй
    location = /index.html { add_header Cache-Control "no-store"; }
    location = /sw.js { add_header Cache-Control "no-store"; }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
